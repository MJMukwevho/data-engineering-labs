# Copy to .env and fill in. .env is git-ignored, so your key stays local.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: comma-separated series (default: SP500,DJIA,NASDAQCOM,VIXCLS,DGS10)
FRED_SERIES=

# Optional: only fetch observations from this date (yyyy-MM-dd); empty = full history
FRED_OBSERVATION_START=

# Your user and group IDs (run `id -u` and `id -g`), so output files are owned by you
HOST_UID=1000
HOST_GID=1000

# --- Local stack (defaults are fine for local use; change if you like) ---

# Object store (RustFS, S3-compatible) login, also used as S3 access keys
S3_ACCESS_KEY=labadmin
S3_SECRET_KEY=labadmin-secret
LAKE_BUCKET=lake

# PostgreSQL warehouse
POSTGRES_DB=warehouse
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab

# Spark worker size
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Host ports: change any that clash with something already running
POSTGRES_PORT=5432
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_APP_UI_PORT=4040
