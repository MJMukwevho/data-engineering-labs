# Copy to .env and fill in. .env is git-ignored, so your key stays local.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: comma-separated series (default: SP500,DJIA,NASDAQCOM,VIXCLS,DGS10)
FRED_SERIES=

# Optional: only fetch observations from this date (yyyy-MM-dd); empty = full history
FRED_OBSERVATION_START=

# Your user and group IDs (run `id -u` and `id -g`), so output files are owned by you
HOST_UID=1000
HOST_GID=1000
